    "color": "^4.2.3",
    "expo": "58.0.17",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-linking": "~58.0.14",
    "expo-navigation-bar": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "koa": "^3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
