{
  "name": "@react-navigation/core",
  "description": "Core utilities for building navigators",
  "version": "8.0.0-alpha.41",
  "keywords": [
    "react",
    "react-native",
    "react-navigation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-navigation/react-navigation.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/react-navigation/react-navigation/issues"
  },
  "homepage": "https://reactnavigation.org",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "@react-navigation/source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./internal": {
      "@react-navigation/source": "./src/internal.tsx",
      "types": "./lib/typescript/src/internal.d.ts",
      "default": "./lib/module/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bob build",
    "clean": "del lib"
  },
  "dependencies": {
    "@react-navigation/routers": "workspace:^",
    "fast-deep-equal": "^3.1.3",
    "react-is": "^19.3.1",
    "use-latest-callback": "^0.3.5",
    "warn-once": "^0.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "@types/react-is": "^19.3.0",
    "del-cli": "^8.0.1",
    "immer": "^11.2.7",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">= 19.2.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
