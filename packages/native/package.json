{
  "name": "@react-navigation/native",
  "description": "React Native integration for React Navigation",
  "version": "8.0.0-alpha.51",
  "keywords": [
    "react-native",
    "react-navigation",
    "ios",
    "android"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-navigation/react-navigation.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/react-navigation/react-navigation/issues"
  },
  "homepage": "https://reactnavigation.org",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "@react-navigation/source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./server": {
      "@react-navigation/source": "./src/server/index.tsx",
      "types": "./lib/typescript/src/server/index.d.ts",
      "default": "./lib/module/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "bob build",
    "clean": "del lib"
  },
  "dependencies": {
    "@react-navigation/core": "workspace:^",
    "@react-navigation/material-symbols": "workspace:^",
    "escape-string-regexp": "^5.0.0",
    "fast-deep-equal": "^3.1.3",
    "nanoid": "^6.0.2",
    "sf-symbols-typescript": "^2.2.0",
    "standard-navigation": "^0.0.9",
    "use-latest-callback": "^0.3.5",
    "warn-once": "^0.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "del-cli": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-web": "~0.21.4",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">= 19.2.0",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNavigationSpec",
    "type": "all",
    "jsSrcsDir": "src/native",
    "android": {
      "components": {
        "ReactNavigationMaterialSymbolView": {
          "className": "ReactNavigationMaterialSymbolView"
        }
      }
    },
    "ios": {
      "components": {
        "ReactNavigationSFSymbolView": {
          "className": "ReactNavigationSFSymbolView"
        },
        "ReactNavigationCornerInsetView": {
          "className": "ReactNavigationCornerInsetView"
        }
      }
    }
  }
}
